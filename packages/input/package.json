{
  "name": "@alisdev/fe-kit-input",
  "version": "1.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "publish:pkg": "pnpm build && (npm view $npm_package_name@$npm_package_version version > /dev/null 2>&1 && echo 'Skipping: Already published' || pnpm publish --no-git-checks --access public)"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.22.5",
    "@tiptap/extension-link": "3.22.5",
    "@tiptap/extension-placeholder": "3.22.5",
    "@tiptap/extension-table": "3.22.5",
    "@tiptap/extension-table-cell": "3.22.5",
    "@tiptap/extension-table-header": "3.22.5",
    "@tiptap/extension-table-row": "3.22.5",
    "@tiptap/extension-text-align": "3.22.5",
    "@tiptap/extension-underline": "3.22.5",
    "@tiptap/pm": "3.22.5",
    "@tiptap/react": "3.22.5",
    "@tiptap/starter-kit": "3.22.5",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "_last_trigger": 1778043749900
}
