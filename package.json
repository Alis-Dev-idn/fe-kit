{
  "name": "@alisdev/fe-kit",
  "version": "2.4.0",
  "packageManager": "pnpm@10.28.0",
  "description": "All-in-one frontend utility kit for React + TypeScript + Vite",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alis-Dev-idn/fe-kit.git"
  },
  "author": "Alis Dev",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build:root": "tsup src/index.ts --format cjs,esm --dts",
    "build": "turbo run build && pnpm build:root",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "publish:pkg": "pnpm build && npm publish --access public"
  },
  "dependencies": {
    "axios": "^1.x",
    "zod": "^3.x"
  },
  "peerDependencies": {
    "react": "^18.x || ^19.x",
    "react-dom": "^18.x || ^19.x"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/react": "^19.x",
    "@types/react-dom": "^19.x",
    "react-router-dom": "^7.14.2",
    "tsup": "^8.x",
    "turbo": "^2.x",
    "typescript": "^5.x",
    "xlsx": "^0.18.5"
  }
}
